# Rotide global config.
# Lives at ~/.rotide/config.toml. Auto-created on first launch.
# Project-local config files are intentionally not loaded.
# This file is the canonical reference; every value below mirrors the
# built-in default. Edit values to customize.

# --- [editor] -----------------------------------------------------------------
# cursor_style: "block" | "bar" | "underline" (case-insensitive).
#   Invalid values fall back to "bar" with a warning.
# cursor_blink: true|false (default true).
# line_wrap: soft-wrap long file rows. true|false (default false).
# line_numbers: absolute line-number gutter. true|false (default true).
# current_line_highlight: subtle active-row background. true|false (default true).
# nerd_fonts: use Nerd Font drawer/header/menu/file-type icons. true|false (default false).
# auto_indent: copy leading indentation on newline and multiline paste.
#   true|false (default false).
# indent_style: "spaces" | "tabs" (default "spaces").
# indent_width: columns per indentation level, 1..16 (default 4).
[editor]
cursor_style = "bar"
cursor_blink = true
line_wrap = false
line_numbers = true
current_line_highlight = true
nerd_fonts = false
auto_indent = false
indent_style = "spaces"
indent_width = 4

# --- [terminal] ---------------------------------------------------------------
# scrollback_lines: how many lines of terminal-pane history to keep for
# wheel-scroll / selection. Default 10000. 0 disables scrollback. Capped at
# 1,000,000. Each retained row owns a cell array sized to the column width at
# capture time (roughly 80 bytes/cell), so a wide pane with the cap maxed out
# can cost in the tens of MB per pane — bump cautiously if you keep many
# terminal panes open.
[terminal]
scrollback_lines = 10000

# --- [theme] ------------------------------------------------------------------
# name selects a built-in theme or a custom theme at ~/.rotide/themes/<name>.toml.
# Built-ins:
#   terminal | a11y-dark | a11y-light | acme | silentium | 256noir |
#   github-light | github-dark |
#   modus-operandi | modus-operandi-tinted | modus-vivendi | modus-vivendi-tinted |
#   molokai | kanagawa-wave | kanagawa-dragon | kanagawa-lotus
#   (alias: kanagawa => kanagawa-wave)
# Custom theme files own [theme.syntax], [theme.ui], and [theme.ansi];
# color values are ANSI 16-color names
# (default|black|red|green|yellow|blue|magenta|cyan|white|
# bright_black|bright_red|bright_green|bright_yellow|bright_blue|bright_magenta|
# bright_cyan|bright_white; aliases: gray/grey => bright_black) or "#RRGGBB".
# [theme.ansi] keys are the same 16 color names and override what the
# terminal pane renders for ANSI-indexed cells (0–15). Slots left unset
# fall back to the theme foreground so output stays inside the theme.
# Invalid custom themes fall back to terminal with a warning.
[theme]
name = "terminal"

# --- [lsp] --------------------------------------------------------------------
# Each *_enabled toggles a built-in LSP server. Legacy `enabled = true|false`
# is still accepted as a shorthand that toggles all servers together.
# *_command sets the command/path used to start each server.
# Install commands (gopls_install_command, javascript_install_command,
# vscode_langservers_install_command) are global-only.
# Default javascript_install_command:
#   "npm install --global --prefix ~/.local typescript typescript-language-server"
# Invalid [lsp] values fall back to defaults with a warning.
[lsp]
gopls_enabled = true
clangd_enabled = true
html_enabled = true
css_enabled = true
json_enabled = true
javascript_enabled = true
eslint_enabled = true
gopls_command = "gopls"
clangd_command = "clangd"
html_command = "~/.local/bin/vscode-html-language-server --stdio"
css_command = "~/.local/bin/vscode-css-language-server --stdio"
json_command = "~/.local/bin/vscode-json-language-server --stdio"
javascript_command = "~/.local/bin/typescript-language-server --stdio"
eslint_command = "~/.local/bin/vscode-eslint-language-server --stdio"

# --- [dap] --------------------------------------------------------------------
# Adapter commands are global-only. Project launch configs live in ./.rotide.toml
# under [dap.launch.<id>]. The DAP drawer can copy one of these defaults into the
# project config for review.
# Each key is a free-form id referenced from [dap.launch.<id>].adapter; the
# value is the command (and arguments) used to start a DAP server on stdio.
# Commented alternatives below are common installs — uncomment the one that
# matches your toolchain, or add your own.
[dap.adapters]
go = "dlv dap"
c = "gdb -i dap"
# c = "lldb-dap"
cpp = "gdb -i dap"
# cpp = "lldb-dap"
# rust = "lldb-dap"
# rust = "gdb -i dap"
# python = "python -m debugpy.adapter"
# javascript = "node ~/.local/lib/node_modules/js-debug/src/dapDebugServer.js"
# typescript = "node ~/.local/lib/node_modules/js-debug/src/dapDebugServer.js"
# ruby = "rdbg --open"
# php = "node ~/.local/lib/node_modules/php-debug/out/phpDebug.js"
# java = "java -jar /path/to/com.microsoft.java.debug.plugin.jar"
# csharp = "netcoredbg --interpreter=vscode"
# haskell = "haskell-debug-adapter"
# ocaml = "ocamlearlybird"

# Each [dap.defaults.<id>] is a launch template the DAP drawer can copy into
# the project config. Its `adapter` must reference a key in [dap.adapters];
# loading the global config fails if that id is missing. Uncomment a default
# only after the matching adapter line above is uncommented. Available
# substitutions in string values: ${workspaceFolder}, ${file},
# ${fileDirname}, ${fileBasename}.
[dap.defaults.go_app]
name = "Go app"
adapter = "go"
request = "launch"
program = "${workspaceFolder}"
cwd = "${workspaceFolder}"
args = []
stopOnEntry = false
mode = "debug"

# C/C++ defaults assume a pre-built executable. Adjust `program` to your
# binary. The same launch fields work for gdb-dap and lldb-dap.
# `console = "terminal"` makes rotide open a split-screen terminal pane
# at launch time and pass its tty to the adapter via the `tty` launch
# field — the inferior renders inside rotide instead of fighting the
# host tty. Set `console = "none"` (or remove the field) to keep the old
# behavior where the inferior shares rotide's tty.
[dap.defaults.c_app]
name = "C app"
adapter = "c"
request = "launch"
program = "${workspaceFolder}/a.out"
cwd = "${workspaceFolder}"
args = []
stopOnEntry = false
console = "terminal"

[dap.defaults.cpp_app]
name = "C++ app"
adapter = "cpp"
request = "launch"
program = "${workspaceFolder}/a.out"
cwd = "${workspaceFolder}"
args = []
stopOnEntry = false
console = "terminal"


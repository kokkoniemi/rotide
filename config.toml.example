# --- [input] ------------------------------------------------------------------
# Selects the active editing-input system. "vim" (the default) enables modal
# editing (Normal/Insert/Visual/Visual-Line) with motions, operators, counts,
# registers, in-buffer search (/ ? n N), text objects, and an ex command line
# (:w :q :%s ...); the active Vim mode is shown in the status bar. "cua" keeps
# the standard desktop-editor key behavior documented under [keymap.cua] below.
# Missing or invalid values fall back to "vim". Project config overrides global.
[input]
system = "vim"

# --- [keymap.cua] -------------------------------------------------------------
# Key spec format:
#   "ctrl+<a-z>", "alt+<a-z>", "ctrl+alt+<a-z>", "ctrl+]"
#   "ctrl+left/right/up/down", "alt+left/right/up/down",
#     "ctrl+alt+left/right/up/down", "alt+shift+left/right/up/down"
#   or a named key: left|right|up|down|home|end|page_up|page_down|
#     enter|esc|backspace|del
# Modifiers are case-insensitive and may appear in any order.
# Each action takes exactly one key; assigning a key that is already in use by
# another action will fail to load. Drop or comment out one side of any pair
# you want to reassign (for example, to use `resize_drawer_narrow = "alt+shift+left"`
# remove or comment out `column_select_left`).
# Rotide binds terminal key codes, so some physical keys alias the same input:
#   "ctrl+i" aliases Tab (avoid; use named keys instead).
#   "ctrl+m" aliases Enter; "ctrl+[" aliases Esc — use only for newline/escape.
#   "ctrl+h" aliases backspace.
# Tab stays reserved for literal text insertion.
# In drawer focus, enter toggles directories and opens files in tabs (reusing
# an already-open tab when possible).
#
# This [keymap.cua] table configures the CUA system (used when [input] system =
# "cua"). It and the Vim system's [keymap.vim] table (at the end of this file)
# are the two first-class keymap tables — there is no bare [keymap] alias.
# Project scope overrides global scope.
[keymap.cua]
quit = "ctrl+q"
save = "ctrl+s"
new_tab = "ctrl+n"
close_tab = "ctrl+w"
next_tab = "alt+right"
prev_tab = "alt+left"
focus_drawer = "ctrl+e"
toggle_drawer = "ctrl+b"
main_menu = "alt+m"
# resize_drawer_narrow and resize_drawer_widen have no default binding.
# To enable them, comment out the conflicting column_select_left/right below.
# resize_drawer_narrow = "alt+shift+left"
# resize_drawer_widen = "alt+shift+right"
toggle_line_wrap = "alt+z"
toggle_line_numbers = "alt+n"
toggle_current_line_highlight = "alt+h"
find_file = "ctrl+p"
project_search = "ctrl+alt+f"
find = "ctrl+f"
find_replace = "ctrl+r"
goto_line = "ctrl+g"
goto_matching_bracket = "ctrl+]"
goto_definition = "ctrl+o"
# Shows blame details for committed lines in saved files inside a Git worktree.
git_blame_details = "alt+b"
# hover has no CUA default binding; Vim Normal mode binds it to "K".
# hover = "alt+k"
# eslint_fix has no default binding; uncomment to enable.
# eslint_fix = "ctrl+alt+e"
# toggle_selection (modal keyboard selection) has no default binding; the
# CUA Shift+move selection below supersedes it. Uncomment to use it.
# toggle_selection = "ctrl+b"
select_all = "ctrl+a"
# Extend the selection with the cursor (CUA-style). A plain (unmodified) move
# collapses the selection instead.
select_left = "shift+left"
select_right = "shift+right"
select_up = "shift+up"
select_down = "shift+down"
select_word_left = "ctrl+shift+left"
select_word_right = "ctrl+shift+right"
select_home = "shift+home"
select_end = "shift+end"
copy_selection = "ctrl+c"
cut_selection = "ctrl+x"
delete_selection = "ctrl+d"
paste = "ctrl+v"
undo = "ctrl+z"
redo = "ctrl+y"
move_home = "home"
move_end = "end"
move_word_left = "ctrl+left"
move_word_right = "ctrl+right"
page_up = "page_up"
page_down = "page_down"
scroll_up = "ctrl+up"
scroll_down = "ctrl+down"
# Horizontal viewport scroll has no default binding; uncomment/remap if desired.
# scroll_left = "ctrl+alt+left"
# scroll_right = "ctrl+alt+right"
move_up = "up"
move_down = "down"
move_left = "left"
move_right = "right"
newline = "enter"
escape = "esc"
redraw = "ctrl+l"
delete_char = "del"
# backspace has two default bindings: "backspace" and "ctrl+h".
# Assigning it explicitly here removes the alternative — leave commented to keep both.
# backspace = "backspace"
move_line_up = "alt+up"
move_line_down = "alt+down"
toggle_comment = "alt+c"
column_select_up = "alt+shift+up"
column_select_down = "alt+shift+down"
column_select_left = "alt+shift+left"
column_select_right = "alt+shift+right"
drawer_create_file = "ctrl+alt+n"
drawer_create_folder = "ctrl+alt+d"
drawer_rename = "ctrl+alt+r"
drawer_delete = "ctrl+alt+k"
git_drawer = "ctrl+alt+g"
# Git actions have no default CUA chords; the Git drawer and the git views
# expose them as single letters (s/u/a/d/c/A/R/P/p/f, B/L/S). Bind chords here
# to also reach them from anywhere, e.g.:
# git_branches = "alt+g"
# git_log = "alt+l"
# git_stashes = "alt+s"
# git_commit = "ctrl+alt+m"
# Other bindable names: git_stage, git_unstage, git_stage_all, git_discard,
# git_commit_amend, git_refresh, git_push, git_pull, git_fetch,
# git_view_activate, git_branch_new, git_branch_delete, git_cherry_pick,
# git_revert, git_tag, git_stash_apply, git_stash_pop, git_stash_drop.
dap_drawer = "ctrl+alt+b"
# DAP control actions have no default binding; uncomment/remap as needed.
# dap_start = "ctrl+alt+s"
# dap_stop = "ctrl+alt+x"
# dap_continue = "ctrl+alt+c"
# dap_pause = "ctrl+alt+p"
# dap_step_over = "ctrl+alt+o"
# dap_step_into = "ctrl+alt+i"
# dap_step_out = "ctrl+alt+u"
# dap_toggle_breakpoint = "ctrl+alt+t"
# Pane splits have no default binding; uncomment to enable.
# split_horizontal splits the focused pane top/bottom; split_vertical
# splits it left/right. close_pane removes the focused pane and promotes
# its sibling. focus_left/right/up/down move focus to the nearest pane
# in that direction. pane_grow / pane_shrink nudge the focused pane's
# size by 5%, clamped so neither pane drops below 10% of its parent.
# Mouse left-click in a non-focused pane also moves focus there. The
# focused pane shows its buffer content; unfocused panes render as blank
# rectangles separated by box-drawing borders. Same-buffer-different-
# tabs (true editor splits) is on the roadmap.
# A split's border can also be grabbed with the left mouse button and
# dragged to resize the two adjoining panes; release ends the drag. The
# drag clamps to the same 10%/90% bounds as pane_grow / pane_shrink.
# split_horizontal = "ctrl+alt+h"
# split_vertical = "ctrl+alt+v"
# close_pane = "ctrl+alt+q"
# focus_left_pane = "ctrl+alt+left"  # NOTE: conflicts with scroll_left
# focus_right_pane = "ctrl+alt+right"  # NOTE: conflicts with scroll_right
# focus_up_pane = "ctrl+alt+up"
# focus_down_pane = "ctrl+alt+down"
# move_tab_<dir>_pane moves the focused pane's active tab into the
# neighbouring pane in that direction; if the source pane has no more
# tabs after the move, an empty buffer is opened in it. Defaults below.
move_tab_left_pane = "ctrl+shift+alt+left"
move_tab_right_pane = "ctrl+shift+alt+right"
move_tab_up_pane = "ctrl+shift+alt+up"
move_tab_down_pane = "ctrl+shift+alt+down"
# pane_grow / pane_shrink: key tokens must be a letter today, so the
# example uses ctrl+alt+y / ctrl+alt+u (any unused letter works).
# pane_grow = "ctrl+alt+y"
# pane_shrink = "ctrl+alt+u"
# terminal_open splits the focused pane top/bottom and runs $SHELL
# (falling back to /bin/sh) in the new sibling. terminal_open_vertical
# does the same with a left/right split. When focus is on a terminal pane, every
# keystroke is routed to the child PTY by default — to invoke a rotide
# action from there, first press terminal_prefix and then the action key.
# The prefix-armed state lasts for exactly one keypress and is shown in
# the message bar.
# terminal_open = "ctrl+alt+t"
# terminal_open_vertical = "ctrl+alt+y"
# terminal_prefix = "ctrl+alt+a"
# open_settings has no default binding; the File > Settings menu item opens it.
# open_settings = "ctrl+alt+s"

# --- [keymap.vim] -------------------------------------------------------------
# Per-mode Vim key bindings (used when [input] system = "vim", the default).
# Entry keys are "<mode>.<command>" where <mode> is normal, insert, or visual
# (visual also covers visual-line). Values are usually a single, case-sensitive
# printable character (e.g. "h", "G", "$", ";"); named keys like "esc" and
# "ctrl+c" also work. Each command takes one key per mode: rebinding relocates it,
# so the built-in default key stops triggering that command unless it is itself
# bound to another command. Unset commands keep their built-in defaults; counts
# ("3dd"), registers ('"a'), search, text objects (iw aw ip ap, bracket/quote
# pairs like i( a{ i" i', and tag it/at), find-char motions (f F t T ; ,), marks
# (m ` '), %, H/M/L, *, #, r ~ J, >> <<, the . repeat, and ":" are built-in and
# not rebindable.
#
# Normal-mode commands: move_left move_down move_up move_right; word_forward
#   word_backward word_end; line_start line_end first_nonblank last_line;
#   insert append insert_line_start append_line_end open_below open_above;
#   delete_char delete change yank delete_to_eol change_to_eol yank_line;
#   paste_after paste_before; search_forward search_backward search_next
#   search_prev; ex_command; visual visual_line.
# Visual-mode commands: the motions above plus delete change yank delete_char paste.
# Insert-mode commands: normal_mode (leave Insert; default "esc").
#
# Leader sequences (Normal mode): "<leader>" then one key runs an editor action.
# Set the leader key with "normal.leader" (default "space"; "space" and a literal
# " " both work). Bind sub-keys with "leader.<command>". Built-in leader commands:
#   find_file (default "p"), project_search ("f"), toggle_drawer ("e"),
#   main_menu ("m"), git_drawer ("g"), git_branches ("b"), git_log ("c"),
#   git_stashes ("s"), git_blame_details (unbound by default; Normal mode uses
#   "gb"). Sub-keys relocate like other commands.
#
# Built-in Vim window commands are not configurable yet: Ctrl-W s/v splits,
# Ctrl-W c/q closes the focused pane, Ctrl-W o closes other panes, Ctrl-W w and
# Ctrl-W W cycle pane focus, Ctrl-W h/j/k/l (or arrows) move focus, and
# Ctrl-W H/J/K/L move the active tab to a neighbour pane. Ctrl-W q is pane-close;
# use :q or Ctrl-Q to quit the app.
#
# Built-in ex aliases include :split/:sp, :vsplit/:vs/:vsp, :e/:edit <file>,
# :split <file>, :vsplit <file>, :close/:clo, :only/:on, :tabclose/:tabc,
# :bd/:bdelete, :tabnew, :term/:terminal, and :vterm. The :git command opens
# the Git drawer; :git branches|log|stash|commit|amend|push|pull|fetch runs the
# matching view or action. Press Tab in the : prompt to complete/cycle command
# names. These spellings are built in and are not configured under [keymap.vim].
#
# [keymap.vim]
# normal.move_left = "h"
# normal.delete = "d"
# visual.yank = "y"
# insert.normal_mode = "esc"
# normal.leader = "space"
# leader.find_file = "p"
# leader.project_search = "f"
# leader.git_blame_details = "B"

# tree-sitter-svelte's grammar.js extends tree-sitter-html; the pinned HTML
# grammar source is linked into node_modules at regeneration time.
TREE_SITTER_SVELTE_GRAMMAR_REF=774a65aea563accc35f5d45fafa4d96ec5761f57
TREE_SITTER_SVELTE_GRAMMAR_LABEL=tree-sitter-svelte-v1.0.2-774a65a

# tree-sitter-vue's grammar.js also extends tree-sitter-html (ESM import); the
# pinned HTML grammar source is linked into node_modules at regeneration time.
# Upstream ships no release tags, so this pins a main-branch commit.
TREE_SITTER_VUE_GRAMMAR_REF=ce8011a414fdf8091f4e4071752efc376f4afb08
TREE_SITTER_VUE_GRAMMAR_LABEL=tree-sitter-vue-main-ce8011a

# helm has no upstream ref: its grammar is authored in-repo at
# vendor/tree_sitter/grammars/helm/grammar.js (a minimal Go template grammar).
# `refresh_tree_sitter_vendor.sh --grammar helm` regenerates parser.c in place.

# wharflab/tree-sitter-containerfile backs RotIDE's "dockerfile" language; the
# grammar/parser is named "containerfile" (tree_sitter_containerfile). Upstream
# tags jump numbering schemes, so this pins the main-branch commit.
TREE_SITTER_DOCKERFILE_GRAMMAR_REF=d13f2847b2cfd74f92f9a122f6e7ac1e6618a39d
TREE_SITTER_DOCKERFILE_GRAMMAR_LABEL=tree-sitter-containerfile-main-d13f284

# sogaiu/tree-sitter-clojure is a deliberately minimal, structural-only grammar
# (parser-only, no external scanner). Its upstream highlights.scm is sparse, so
# RotIDE ships a richer repo-local query under src/language/queries/clojure/.
TREE_SITTER_CLOJURE_GRAMMAR_REF=3a1ace906c151dd631cf6f149b5083f2b60e6a9e
TREE_SITTER_CLOJURE_GRAMMAR_LABEL=tree-sitter-clojure-v0.0.13-3a1ace9

# r-lib/tree-sitter-r backs RotIDE's "r" language (parser tree_sitter_r). Ships
# an external scanner; upstream highlights.scm + locals.scm map cleanly and are
# vendored as-is.
TREE_SITTER_R_GRAMMAR_REF=346d3707b8c9301f1051e8f6e32666e67529f7d2
TREE_SITTER_R_GRAMMAR_LABEL=tree-sitter-r-v1.3.0-346d370

# Official CLI binary release used for regeneration.
TREE_SITTER_CLI_RELEASE=v0.26.8

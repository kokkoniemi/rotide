TREE_SITTER_VUE_GRAMMAR_LABEL=tree-sitter-vue-main-ce8011a

# helm has no upstream ref: its grammar is authored in-repo at
# vendor/tree_sitter/grammars/helm/grammar.js (a minimal Go template grammar).
# `refresh_tree_sitter_vendor.sh --grammar helm` regenerates parser.c in place.

# wharflab/tree-sitter-containerfile backs RotIDE's "dockerfile" language; the
# grammar/parser is named "containerfile" (tree_sitter_containerfile). Upstream
# tags jump numbering schemes, so this pins the main-branch commit.
TREE_SITTER_DOCKERFILE_GRAMMAR_REF=d13f2847b2cfd74f92f9a122f6e7ac1e6618a39d
TREE_SITTER_DOCKERFILE_GRAMMAR_LABEL=tree-sitter-containerfile-main-d13f284

# sogaiu/tree-sitter-clojure is a deliberately minimal, structural-only grammar
# (parser-only, no external scanner). Its upstream highlights.scm is sparse, so
# RotIDE ships a richer repo-local query under src/language/queries/clojure/.
TREE_SITTER_CLOJURE_GRAMMAR_REF=3a1ace906c151dd631cf6f149b5083f2b60e6a9e
TREE_SITTER_CLOJURE_GRAMMAR_LABEL=tree-sitter-clojure-v0.0.13-3a1ace9

# r-lib/tree-sitter-r backs RotIDE's "r" language (parser tree_sitter_r). Upstream
# highlights.scm + locals.scm are vendored as-is, but the grammar itself is replaced
# with the reduced highlight grammar under overrides/r/ before generation (drops the
# external scanner and newline-tracking states, ~5x smaller parser.c).
TREE_SITTER_R_GRAMMAR_REF=346d3707b8c9301f1051e8f6e32666e67529f7d2
TREE_SITTER_R_GRAMMAR_LABEL=tree-sitter-r-v1.3.0-346d370

# PrestonKnopp/tree-sitter-gdscript backs RotIDE's "gdscript" language (parser
# tree_sitter_gdscript, root node "source"). Ships an external scanner
# (indentation/newline tracking + string delimiters). Upstream vendors no
# highlight queries, so RotIDE ships a repo-local query under
# src/language/queries/gdscript/.
TREE_SITTER_GDSCRIPT_GRAMMAR_REF=d2a0ee914d297b873a40dd4596bd1f7157ebc52b
TREE_SITTER_GDSCRIPT_GRAMMAR_LABEL=tree-sitter-gdscript-v6.1.0-d2a0ee9

# tree-sitter-grammars/tree-sitter-zig backs RotIDE's "zig" language (parser
# tree_sitter_zig, root node "source_file"). Ships a small external scanner.
# Upstream ships highlight/injection queries, but its highlights.scm relies on
# `#lua-match?` (which RotIDE does not model and would treat as always-pass,
# marking every identifier as a type/constant), so RotIDE ships a repo-local
# query under src/language/queries/zig/ that swaps `#lua-match?` for `#match?`.
TREE_SITTER_ZIG_GRAMMAR_REF=b670c8df85a1568f498aa5c8cae42f51a90473c0
TREE_SITTER_ZIG_GRAMMAR_LABEL=tree-sitter-zig-v1.1.2-b670c8d

# alex-pinkus/tree-sitter-swift backs RotIDE's "swift" language (parser
# tree_sitter_swift, root node "source_file"). The grammar is replaced by the
# reduced override at vendor/tree_sitter/overrides/swift/grammar.js before
# generation: no external scanner (upstream's stateful C scanner handled nested
# block comments, `#`-balanced raw strings, and implicit-semicolon lookahead;
# the override uses regex tokens plus the tree-sitter-go newline-terminator
# trick), a flattened expression grammar, and funneled containers — ~20 MB /
# 10321-state upstream parser.c becomes ~3 MB / 1949 states (~3.7 MB object →
# ~650 KB) with byte-identical fixture captures. Both highlights.scm and
# injections.scm are vendored as-is: every capture name maps to a RotIDE class
# and the query uses only `#match?`. Injections route regex literals to the
# regex grammar (comment→comment resolves to nothing, skipped).
TREE_SITTER_SWIFT_GRAMMAR_REF=b8b22bffbb3441780e6471665bacfb263741c86a
TREE_SITTER_SWIFT_GRAMMAR_LABEL=tree-sitter-swift-v0.7.3-b8b22bf

# tree-sitter-perl/tree-sitter-perl backs RotIDE's "perl" language (parser
# tree_sitter_perl, root node "source_file"). The v1.2.1 source commit is the ref
# tracked by the generated release branch. The grammar is replaced by the reduced
# override at vendor/tree_sitter/overrides/perl/ before generation: upstream's
# 54-token scanner (with generated intuit headers) becomes a ~230-line scanner
# handling only heredocs and POD, quote-like operators become regex tokens over
# the common delimiters, and all infix operators collapse into one flat rule —
# ~29 MB / 5749-state parser.c becomes ~5.9 MB / 1586 states (~4.7 MB object →
# ~930 KB) with near-identical fixture captures. The upstream highlight query is
# patched from `#lua-match?` to standard `#match?` during refresh; the
# substitution injection also opts into child ranges for RotIDE.
TREE_SITTER_PERL_GRAMMAR_REF=c3e17b31179bf8f658c9f37c7a3ea6a202212d5a
TREE_SITTER_PERL_GRAMMAR_LABEL=tree-sitter-perl-v1.2.1-c3e17b3

# 6cdh/tree-sitter-scheme backs RotIDE's "scheme" language (parser
# tree_sitter_scheme, root node "program"). Parser-only, no external scanner.
# Upstream ships a single highlights.scm whose capture names all map cleanly to
# RotIDE classes and which uses only `#match?` predicates, so it is vendored
# as-is (the `@escape` secondary captures resolve to no class and are ignored).
# The pinned ref is the latest release tag; the main branch only renames the npm
# package on top of it.
TREE_SITTER_SCHEME_GRAMMAR_REF=933883742f909cf79bd8aa6fde05ef51d79c9263
TREE_SITTER_SCHEME_GRAMMAR_LABEL=tree-sitter-scheme-v0.24.7-1-9338837

# WhatsApp/tree-sitter-erlang backs RotIDE's "erlang" language (parser
# tree_sitter_erlang, root node "source_file"). Ships a small external scanner.
# The pinned ref is the 0.19 release tag and also matched upstream HEAD when
# added. Upstream highlights.scm is vendored as-is; every useful capture name
# maps to a RotIDE class.
TREE_SITTER_ERLANG_GRAMMAR_REF=836aa2b6c3af2c7cef3f84049b0ed6d44485a870
TREE_SITTER_ERLANG_GRAMMAR_LABEL=tree-sitter-erlang-0.19-836aa2b

# elixir-lang/tree-sitter-elixir backs RotIDE's "elixir" language (parser
# tree_sitter_elixir, root node "source"). Ships a small external scanner
# (heredocs, sigils, interpolation) that is kept. The grammar is replaced by a
# reduced highlight override at vendor/tree_sitter/overrides/elixir/grammar.js
# before generation: the 20-tier operator table collapses to a few flat
# alternatives and sigils use non-interpolating quoted rules (all ten delimiters
# kept), shrinking ~13.2 MB / 7001-state parser.c to ~9.4 MB / 4823 states
# (object ~1.6 MB -> ~1.17 MB) with identical fixture captures. Both
# highlights.scm and injections.scm are vendored as-is: every useful capture name
# maps to a RotIDE class and the queries use only #match?/#any-of?/#eq?.
# Injections route sigils to registered languages (~r regex, ~MD markdown,
# ~PY python, ~JS javascript, ~VUE vue); unregistered targets (heex, sql) skip.
TREE_SITTER_ELIXIR_GRAMMAR_REF=e2d9e6e0e76b0c436fa48a0b8c32a031d0cbdf49
TREE_SITTER_ELIXIR_GRAMMAR_LABEL=tree-sitter-elixir-v0.3.5-e2d9e6e

# Official CLI binary release used for regeneration.
TREE_SITTER_CLI_RELEASE=v0.26.8

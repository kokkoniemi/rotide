@startuml
skin rose
!include <C4/C4_Component>
skinparam backgroundColor #FFFFFF

title Test categories vs. what they exercise

Component(harness, "Test harness", "C", "Single binary; one runner; suites are arrays of editorTestCase")

Component(helpers, "Isolated helpers", "no editor state", "utf8 decode/encode; rope ops; runner internals")
Component(pipeline, "Pipeline tests", "drive editorConfig E", "Edit pipeline, syntax activation, layout, render, input dispatch, save/recovery")
Component(property, "Property / differential", "seeded random ops", "text_invariants (rope vs char* + memmove); syntax_incremental_equiv (incremental vs full reparse)")
Component(subprocess, "Subprocess tests", "real fork/PTY/RPC", "PTY tests; terminal_pane; LSP mock framing; DAP launches; file_watch")

Component(rotide_lib, "Editor sources", "compiled into test binary", "Same .c files as the rotide binary, minus rotide.c's main")
Component(fixtures, "Fixtures", "checked-in inputs", "tests/syntax/supported/*; theme/keymap TOMLs; recovery snapshots")
Component(mocks, "Mocks", "in-process", "LSP mock singleton; save syscalls hook; alloc failure hook")

Rel(harness, helpers, "dispatches")
Rel(harness, pipeline, "dispatches")
Rel(harness, property, "dispatches")
Rel(harness, subprocess, "dispatches")

Rel(pipeline, rotide_lib, "calls public API")
Rel(property, rotide_lib, "calls public API")
Rel(subprocess, rotide_lib, "calls + forks children")
Rel(helpers, rotide_lib, "calls leaf functions only")

Rel(pipeline, fixtures, "reads")
Rel(property, fixtures, "reads")
Rel(subprocess, mocks, "manipulates LSP/save mocks")
Rel(pipeline, mocks, "manipulates alloc/save mocks")

@enduml

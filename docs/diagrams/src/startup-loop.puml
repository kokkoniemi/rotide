@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Startup and main loop

start
:enable raw terminal mode;
:initialize editor state
(theme, drawer, layout, bootstrap tab);
:start syntax background worker;
:apply config (theme/keymap/LSP/DAP);
:restore recovery snapshot or open CLI args;
:restore workspace state (drawer, tabs, layout);

while (running)
  :poll syntax worker;
  :pump LSP / DAP;
  :update viewport;
  :render frame;
  :process one input event;
endwhile

:on quit or termination signal:
shut down DAP, LSP, syntax worker,
release shared resources,
restore terminal;
stop

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Startup and main loop

start
:enable terminal raw mode (setRawMode);
:initEditor — clipboard, theme, drawer state,
single-leaf layout root + focused leaf, tabs;
:start Tree-sitter background worker;
:bootstrap global config file
(create if missing);
:initialize recovery and workspace state
for current directory;
:apply configured editor/theme/keymap/LSP/DAP settings;
if (recovery snapshot or CLI args?) then (yes)
	:load recovery or open CLI args;
else (no)
	:fall through to drawer init;
endif
:drawer init for startup;
:load and apply workspace state
(restore drawer width, tabs, persisted layout);
:Git init for working tree;
while (running)
	:editorSyntaxBackgroundPoll;
	:editorLspPumpNotifications;
	:editorDapPumpNotifications;
	:editorViewportUpdateForFrame;
	:editorRefreshScreen
	 (pure renderer - no pumping);
	:editorProcessKeypress
	 (decode input, dispatch action,
	  handle terminal/paste events);
endwhile
:on quit action OR
 SIGINT/SIGTERM/SIGHUP/SIGQUIT
 -> editorHandleTerminationSignal:
 editorDapShutdown,
 editorLspShutdown,
 editorSyntaxBackgroundStop,
 editorSyntaxReleaseSharedResources,
 editorRestoreTerminal;
stop

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Edit application (editorApplyDocumentEdit)

participant "caller\n(edit / undo / paste / restore)" as input
participant "edit_pipeline.c" as pipe
participant "editorDocument" as doc
participant "row cache" as rows
participant "history" as history
participant "post_edit_notify.c" as notify
participant "syntax state" as syntax
participant "LSP" as lsp

input -> pipe : editorDocumentEdit\n(byte range, text,\n before/after cursor,\n before/after dirty)
pipe -> doc : replace byte range
pipe -> rows : splice + rebuild affected rows
pipe -> pipe : sync cursor offset
pipe -> pipe : set dirty = edit.after_dirty
pipe -> history : record pending op (if any)
pipe -> notify : editorNotifyPostEditLanguage
notify -> syntax : apply Tree-sitter edit / invalidate spans
notify -> lsp : didChange (range or full)
pipe --> input : ok / fail

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Pane layout and view ownership

skinparam classBackgroundColor #FFFFFF

class "editor state" as E {
  layout_root
  focused_leaf
  active_buffer
  tabs[]
}

class "pane node" as Node {
  split or leaf
}

class "split" as Split {
  orientation, ratio
}

class "pane (leaf)" as Pane {
  kind: editor | terminal
  view
  kind_state
}

class "pane view" as View {
  cursor, scroll, viewport mode
  selection
  active tab + tab membership
}

E --> Node : layout_root
E ..> Node : focused_leaf
Node --> Split
Node --> Pane
Pane *-- View

note right of View
  Focused leaf's view is mirrored into
  the editor's active state. Switching
  focus saves outgoing view, optionally
  swaps active tab, loads incoming view.
end note

note bottom of Node
  Renderer reserves 1 col/row borders
  between siblings; persisted as an
  s-expression in workspace state.
end note

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title LSP document and request flow

participant "tab/document" as tab
participant "lsp_registry.c" as registry
participant "lsp_documents.c\n/ lsp_features.c" as lsp
participant "lsp_protocol.c" as protocol
participant "lsp_transport.c" as transport
participant "language server" as server
participant "renderer/drawer" as ui

tab -> registry : editorLspEnsureClientForFile(\n  filename, ...)
note right of registry
  Lookup or spawn keyed by
  (server_kind, workspace_root).
  No implicit "active LSP" singleton.
end note
registry --> tab : struct editorLspClient *client

tab -> lsp : open / edit / request\n(passes explicit client)
lsp -> protocol : build didOpen / didChange / request
protocol -> transport : framed JSON-RPC
transport -> server : stdin/stdout
server --> transport : diagnostics / response
transport --> protocol : parse JSON
protocol --> lsp : locations, symbols, diagnostics, edits
lsp --> tab : update tab-local state
tab --> ui : overlays and LSP drawer entries

@enduml

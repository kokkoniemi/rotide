@startuml
skin rose
skinparam backgroundColor #FFFFFF
title LSP request flow

participant "tab action" as tab
participant "lsp_registry.c" as registry
participant "lsp_documents.c" as docs
participant "lsp_features.c" as features
participant "lsp_protocol.c" as protocol
participant "lsp_transport.c" as transport
participant "language server" as server
participant "renderer / drawer" as ui

tab -> registry : editorLspEnsureClientForFile(filename, language)
note right
  Lookup or spawn by
  (server_kind, workspace_root).
  Reused across tabs;
  no implicit "active LSP".
end note
registry --> tab : client handle

tab -> docs : open / edit / save / close
docs -> protocol : build didOpen / didChange / didSave / didClose
protocol -> transport : framed JSON-RPC
transport -> server : stdin

tab -> features : definition / completion / symbols / code action
features -> protocol : build request
protocol -> transport : framed JSON-RPC
transport -> server : stdin

server --> transport : stdout (response or diagnostics)
transport --> features : parse via lsp_responses.c
features --> tab : update tab-local state
tab --> ui : overlays, drawer entries

@enduml

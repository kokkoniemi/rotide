@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Test runner pipeline (tests/rotide_tests)

start

:parse runner flags
(filter, tag, repeat, seed,
jobs, metrics, golden update);
:select tests;
if (--no-quarantine?) then (yes)
	:include quarantined tests;
else (no)
	:skip tests/QUARANTINE.md entries;
endif
:order by suite index
(shuffle flag permutes the order);

if (jobs > 1?) then (parallel)
	:fork one child per suite
	(up to N concurrent);
	note right
		stdout/stderr to
		tests/artifacts/logs/<suite>.log
	end note
	:per test in child:
	reset, run, reset
	(verify reset if validate-reset on);
	:on crash: write artifact,
	re-raise signal;
	note right
		tests/artifacts/crashes/
		<suite>/<test>.crash
	end note
	:parent reaps child,
	collects log;
else (sequential)
	:per test:
	reset, run, reset
	(verify reset if validate-reset on);
endif

:emit PASS / FAIL / SKIP
in suite-index order;
if (--update-golden?) then (yes)
	:ASSERT_GRID_EQ mismatches
	append JSONL stash rows;
endif
:summary line:
N/M passed, drift, crashes, seed;
if (--metrics-out?) then (yes)
	:append kind=test_run
	metrics row;
endif

stop

@enduml

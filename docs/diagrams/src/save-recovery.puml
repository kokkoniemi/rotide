@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Save and recovery flow

start
if (save requested?) then (save)
  :copy active document text;
  :mkstemp sibling temp file;
  :write all bytes;
  :fsync temp fd;
  :close temp fd;
  :rename temp over target;
  :open parent directory;
  :fsync directory fd;
  :close directory fd;
  :clear dirty (only after success);
  :notify LSP didSave;
  :refresh Git status;
else (autosave)
  :serialize tab state and document text;
  :write recovery snapshot;
endif

if (startup sees recovery snapshot?) then (yes)
  :prompt user;
  :restore tabs through document model;
  :rebuild derived rows;
else (no)
  :open CLI args or empty tab;
endif
stop

@enduml

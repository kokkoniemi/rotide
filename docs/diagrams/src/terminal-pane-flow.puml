@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Terminal pane lifecycle

start
:Create terminal leaf;
:forkpty child command;
:Attach libvterm to PTY master;

partition "event loop" {
	repeat
		:Poll input tick;
		:Pump PTY output into libvterm;
		if (bytes read?) then (yes)
			:return TERMINAL_EVENT;
		endif
		if (child exited?) then (yes)
			:mark terminal exited;
			:close exited panes;
			:restore focus if needed;
		endif
	repeat while (editor running)
}

partition "render/input" {
	:Paint vterm cells inside pane rect;
	:Use vterm cursor for focused terminal;
	:Forward keys, paste, and tracked mouse;
	:Resize PTY on SIGWINCH/layout change;
}

stop

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Terminal pane lifecycle

start
:create terminal leaf;
:fork PTY child;
:attach libvterm parser;

repeat
  :pump PTY -> vterm on each input tick;
  if (bytes consumed?) then (yes)
    :emit TERMINAL_EVENT (repaint);
  endif
  if (child exited?) then (yes)
    :mark exited; close pane;
    :restore focus to surviving sibling;
  endif
repeat while (editor running)

partition "render / input" {
  :paint vterm cells in pane rect;
  :forward keys, paste, tracked mouse to PTY;
  :resize PTY on layout / SIGWINCH;
}

stop

@enduml

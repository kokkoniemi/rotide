@startuml
skin rose
!include <C4/C4_Container>
skinparam backgroundColor #FFFFFF

title RotIDE container architecture

Person(user, "User", "Edits files in a terminal")
System_Boundary(rotide, "RotIDE") {
	Container(input, "Input and actions", "C", "Terminal decoding, keymap lookup, prompts, mouse handling, terminal-pane key routing")
	Container(editing, "Editing core", "C", "Document edit pipeline, selection, history, dirty state")
	Container(document, "Document model", "C", "editorDocument plus rope and line-start index")
	Container(render, "Renderer", "C", "Tab bar, drawer, multi-pane painter, borders, overlays, libvterm cell painter")
	Container(workspace, "Workspace and layout", "C", "Tabs, drawer, pane tree (splits/focus), task logs, recovery, file search, workspace persistence")
	Container(language, "Language services", "C", "Tree-sitter syntax, LSP, autocomplete")
	Container(terminal, "Terminal panes", "C + libvterm", "PTY transport, vterm parser, scrollback, mouse/paste forwarding")
	Container(dap, "DAP", "C", "Adapter spawn, launch with optional terminal console, breakpoints, lifecycle")
	Container(config, "Config", "TOML", "Editor, theme, keymap, LSP, and DAP settings")
}

System_Ext(files, "Filesystem", "Source files, config, recovery and workspace snapshots")
System_Ext(ts, "Tree-sitter", "Vendored parsers and runtime")
System_Ext(lsp, "Language servers", "gopls, clangd, TypeScript, vscode extracted servers, ESLint")
System_Ext(pty_children, "PTY children", "Shells, debuggees, debug-adapter inferiors")
System_Ext(adapters, "DAP adapters", "gdb -i dap, lldb-dap, dlv dap, etc.")

Rel(user, input, "Keys and mouse")
Rel(input, editing, "editorAction and edit requests")
Rel(input, terminal, "Forwarded keys / mouse / paste when focused on a terminal pane")
Rel(input, dap, "DAP control actions")
Rel(editing, document, "Mutates canonical text")
Rel(editing, language, "Syntax edits and LSP notifications")
Rel(render, document, "Reads derived rows/text")
Rel(render, workspace, "Reads tabs, drawer state, pane layout")
Rel(render, terminal, "Reads vterm grid, pumps PTY")
Rel(config, input, "Key bindings")
Rel(config, language, "Server commands and enable flags")
Rel(config, dap, "Adapters, launch configs, console mode")
Rel(workspace, files, "Open, save, recover, watch, persist layout")
Rel(language, ts, "Parse and query")
Rel(language, lsp, "JSON-RPC")
Rel(terminal, pty_children, "stdin/stdout via PTY master fd")
Rel(dap, adapters, "JSON-RPC over stdio")
Rel(dap, terminal, "console=terminal opens a pane and supplies its tty to the adapter")
Rel(user, render, "Views terminal frame")

@enduml

@startuml
skin rose
!include <C4/C4_Container>
skinparam backgroundColor #FFFFFF

title RotIDE container relationships

Person(user, "User")

System_Boundary(rotide, "RotIDE") {
	Container(input, "Input", "C", "Decodes terminal events; routes to actions, prompts, or pane forwarding")
	Container(text, "Text engine", "C", "Owns canonical document bytes, edits, history, selection")
	Container(workspace, "Workspace", "C", "Tabs, pane tree, drawer, project search, Git, recovery, persistence")
	Container(renderer, "Renderer", "C", "Builds the terminal frame from current state")
	Container(language, "Language services", "C", "Tree-sitter highlighting and LSP (per-workspace clients)")
	Container(terminal, "Terminal + DAP", "C + libvterm", "PTY-backed panes; DAP client")
	Container(config, "Config", "TOML", "User and project settings")
}

System_Ext(files, "Filesystem", "Source files, snapshots, config")
System_Ext(ts, "Tree-sitter", "Vendored parsers and runtime")
System_Ext(lsp, "Language servers", "gopls, clangd, TypeScript, ESLint")
System_Ext(pty_children, "PTY children", "Shells and debuggees")
System_Ext(adapters, "DAP adapters", "gdb-dap, lldb-dap, dlv dap")

Rel(user, input, "Keys/mouse")
Rel(user, renderer, "Views frame")

Rel(config, input, "Settings")
Rel(input, text, "Editor actions")
Rel(input, terminal, "Forwarded keys")
Rel(text, language, "Sync edits")
Rel(renderer, text, "Reads rows")
Rel(renderer, workspace, "Reads layout")
Rel(renderer, terminal, "Paints vterm cells")

Rel(workspace, files, "Open, save, recover, watch")
Rel(language, ts, "Parse/query")
Rel(language, lsp, "JSON-RPC")
Rel(terminal, pty_children, "PTY")
Rel(terminal, adapters, "DAP JSON-RPC")

@enduml

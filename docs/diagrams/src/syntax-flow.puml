@startuml
skinparam backgroundColor #FFFFFF
title Tree-sitter syntax flow

start
:detect language from filename/shebang;
:create tab-local editorSyntaxState;
:parse document through editorTextSource;
if (edit arrives?) then (yes)
	:apply Tree-sitter edit;
	:incremental parse, fallback full parse when needed;
else (no)
	:keep current parse tree;
endif
:collect captures for visible byte ranges;
if (injection query matches?) then (yes)
	:parse injected language up to depth/slot limits;
else (no)
	:use host-language captures only;
endif
:renderer applies syntax spans under overlays;
stop

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Syntax worker: snapshot / revision protocol

participant "main thread" as main
participant "shared slot" as slot
participant "worker thread" as worker

main -> main : edit -> bump revision\nlanguage change -> bump generation
main -> slot : schedule(language, revision, generation, bytes copy)
note right
  Slot holds at most one queued job.
  A newer job replaces an older one.
end note
slot --> worker : wake

worker -> worker : parse + collect captures\n(worker-private memory)
worker -> slot : publish result
note right
  Slot holds at most one result;
  intermediate results overwrite.
end note

main -> slot : poll (per tick)
slot --> main : result
alt result tag matches current state
  main -> main : adopt parser state, merge spans
else stale
  main -> main : discard
end

@enduml

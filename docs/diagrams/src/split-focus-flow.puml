@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Split, focus, and close

start
partition "split" {
  :save focused view into outgoing leaf;
  :wrap focused leaf in a split node;
  :new sibling inherits view;
  :reset sibling's tab membership to just
   the splitting pane's active tab;
  :focus the sibling;
}
stop

start
partition "focus change" {
  :save outgoing view;
  if (incoming leaf records a different active tab?) then (yes)
    :swap global active tab;
  endif
  :load incoming view into active state;
}
stop

start
partition "close" {
  :promote sibling in place of split;
  :load sibling's view;
}
stop

@enduml

@startuml
skin rose
skinparam backgroundColor #FFFFFF
title DAP launch and lifecycle

start
:dap_start selects launch config;
:shutdown previous DAP session;
:copy launch config;
if (console == "terminal"?) then (yes)
	:open terminal pane with
	temporary "sleep infinity";
	:resolve slave tty via ptsname;
	:stop placeholder child;
	:set launch.tty = "/dev/pts/N";
	:remember owned pane;
else (no)
	:continue without terminal pane;
endif
:strip rotide-only console field;
:spawn adapter over stdio;
:send initialize;
:send launch;

partition "session" {
	repeat
		:pump adapter notifications;
		:update DAP state/events;
	repeat while (running)
}

:terminated, exited, or stop;
:shutdown adapter;
:close owned terminal pane if present;
:restore focus;
stop

@enduml

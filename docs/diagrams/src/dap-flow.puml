@startuml
skin rose
skinparam backgroundColor #FFFFFF
title DAP launch and lifecycle

start
:select launch config;
:shut down previous DAP session;
:copy launch config for mutation;
if (console == "terminal"?) then (yes)
  :open terminal pane around a
  childless PTY (no fork);
  :set launch.tty = slave path;
  :remember owned pane;
else (no)
  :continue without terminal pane;
endif
:strip rotide-only console field;
:spawn adapter over stdio;
:send initialize;
:queue launch (not sent yet);

partition "handshake (event-driven)" {
  :initialize response;
  :send queued launch;
  :initialized event;
  :send setBreakpoints (per source);
  :send configurationDone;
}

partition "session" {
  repeat
    :pump adapter notifications;
    if (stopped event?) then (yes)
      :threads;
      :stackTrace (stopped thread);
      :scopes (top frame);
      :variables (each scope);
      :update drawer + stopped marker;
    else (no)
      :output / continued / state update;
    endif
  repeat while (running?) is (yes)
  ->no;
}

:terminated, exited, or explicit stop;
:shut down adapter;
if (owned terminal pane?) then (yes)
  :close owned terminal pane;
  :restore focus to sibling;
else (no)
endif
stop

@enduml

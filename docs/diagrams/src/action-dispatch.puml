@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Input dispatch (editorProcessKeypress)

start
:editorReadKey returns event or byte;
if (synthetic event?) then (yes)
  :event-specific handler;
  stop
else (no)
endif
if (popup visible?) then (yes)
  :route to popup handler;
  if (consumed?) then (yes)
    stop
  else (no)
  endif
else (no)
endif
if (mouse event?) then (yes)
  :hit-test layout and dispatch;
  stop
else (no)
endif
if (focused terminal?) then (yes)
  if (Terminal Normal mode?) then (yes)
    :resolve leader / Ctrl-W;
    :i/a/I/A return to Job/Insert;
    stop
  else (Job/Insert)
    if (Ctrl-W chord?) then (yes)
      :mode or window command;
      stop
    else (no)
      :forward key to PTY;
      stop
    endif
  endif
else (no)
endif
if (Git or search-field context?) then (yes)
  :run focus-specific handler;
  if (consumed?) then (yes)
    stop
  else (no)
  endif
else (no)
endif
:editorVimHandleKey;
:resolve modal command / editorAction;
if (action mutates text?) then (yes)
  :apply edit through edit pipeline;
else (no)
  :update non-document state;
endif
stop

@enduml

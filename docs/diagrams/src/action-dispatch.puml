@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Input dispatch (editorProcessKeypress)

start
:editorReadKey returns event or byte;
if (synthetic event?) then (yes)
  :event-specific handler
  (EOF / RESIZE / TASK / SYNTAX /
   WATCH / TERMINAL / PASTE);
  stop
else (no)
endif
if (popup visible?) then (yes)
  :route key to popup handler
  (autocomplete refilter or accept);
  if (consumed?) then (yes)
    stop
  else (no)
  endif
else (no)
endif
if (mouse event?) then (yes)
  :hit-test layout;
  :route to terminal pane / drawer /
   tab strip / text area;
  stop
else (no)
endif
if (focused leaf is terminal pane
    and not in drawer focus?) then (yes)
  if (terminal_prefix armed?) then (yes)
    :clear prefix and fall through to keymap;
  else (no)
    if (key matches terminal_prefix?) then (yes)
      :arm one-shot prefix;
      stop
    else (no)
      :forward key to PTY;
      stop
    endif
  endif
else (no)
endif
:delegate to active input system
 (editorInputSystemActive()->handle_key);
if (system == vim?) then (yes)
  :modal state machine resolves key
   (mode, counts, operators, registers,
    motions, text objects, search, ex line);
else (cua)
  :keymap lookup -> editorAction;
endif
:resolved editorAction / command;
if (action mutates text?) then (yes)
  :apply edit through edit pipeline;
else (no)
  :update non-document state;
endif
stop

@enduml

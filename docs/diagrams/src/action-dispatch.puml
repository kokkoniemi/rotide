@startuml
skin rose
skinparam backgroundColor #FFFFFF
title Keypress to editor action

start
:terminal decodes input
or synthetic event;
if (synthetic event?) then (yes)
	:run event-specific gate
(resize/task/syntax/watch/
terminal/paste/EOF);
	stop
else (no)
endif
if (prompt active?) then (yes)
	:prompt module handles byte;
	stop
else (no)
endif
if (mouse event?) then (yes)
	:mouse module hit-tests and routes
to terminal/drawer/tab/text;
	stop
else (no)
endif
if (terminal key gate?) then (yes)
	if (prefix armed?) then (yes)
		:clear prefix and fall through;
	else (no)
		if (key is terminal_prefix?) then (yes)
			:arm one-shot prefix;
			stop
		else (no)
			:send key to focused PTY;
			stop
		endif
	endif
else (no)
endif
:lookup configured keymap;
if (bound action?) then (yes)
	:dispatch enum editorAction
to action family helper;
else (no)
	:text-pair / insert handling;
endif
if (text mutation?) then (yes)
	:apply document edit;
else (no)
	:update non-document state;
endif
stop

@enduml

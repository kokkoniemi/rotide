{
    // Build tasks referenced by .vscode/launch.json preLaunchTask entries.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build c fixture",
            "type": "shell",
            "command": "make",
            "args": ["-C", "tests/dap/supported/c"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build rotide",
            "type": "shell",
            "command": "make",
            "args": ["rotide"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
